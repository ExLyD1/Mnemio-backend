// "User U is learning deck D": the distinct cards U has studied in D, in any
// mode (SRS rating, flashcard / multiple-choice progress, review runs), own
// deck or someone else's public one. Written as a best-effort side effect of
// POST /srs/rate and session progress/complete; read only by GET /library.
// It never feeds XP, streaks, DailyActivity, achievements or /stats/*.
model UserDeck {
  userId         String
  deckId         String
  // Distinct card ids, ≤ the deck's size (≤ 1000). Ids of cards deleted later
  // are kept: "studied once" stays studied.
  studiedCardIds String[] @default([])
  // = cardinality(studiedCardIds), kept denormalized for the library query.
  studiedCount   Int      @default(0)
  lastStudiedAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@id([userId, deckId])
  @@index([userId, lastStudiedAt])
  @@map("user_decks")
}

model Subscription {
  id                 String    @id @default(uuid())
  userId             String    @unique
  status             String
  plan               String

  paddleCustomerId   String    @unique
  paddleSubId        String    @unique
  paddlePriceId      String
  // Which product the price belongs to. Stored alongside the price because
  // entitlement is a product-level question ("do they own Premium?") while the
  // price only says how they pay for it — swapping monthly↔annual changes the
  // price id but not what they're entitled to.
  // Defaults to '' only so the column could be added to existing rows.
  paddleProductId    String    @default("")

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  // True while Paddle reports a scheduled_change whose action is "cancel".
  // Access is NOT revoked on this flag alone — only a real `canceled` status
  // ends entitlement (see subscription.repository.isEntitled).
  cancelAtPeriodEnd  Boolean   @default(false)
  trialEnd           DateTime?

  scheduledChangeAction   String?
  scheduledChangeAt       DateTime?
  scheduledResumeAt       DateTime?
  priceAmount             Int?
  currency                String?
  cardBrand               String?
  cardLast4               String?
  cardExpMonth            Int?
  cardExpYear             Int?
  declineReason           String?
  pastDueAmount           Int?
  pastDueCurrency         String?
  pastDueAt               DateTime?
  scheduledPlan           String?
  cancelReason            String?
  cancelFeedback          String?
  cancelRequestedAt       DateTime?
  trialEndingEmailSentAt  DateTime?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([paddleCustomerId])
  @@map("subscriptions")
}

// Idempotency ledger. Paddle delivers at-least-once and may deliver out of
// order, so each event id is recorded inside the same transaction that applies
// it; a redelivery finds the row and becomes a no-op.
model PaddleWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@map("paddle_webhook_events")
}
